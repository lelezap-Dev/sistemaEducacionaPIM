# ============================================================================
#  Modelo de variáveis de ambiente do Sistema Lumina
#
#  Copie este arquivo para ".env" e substitua os valores.
#  O arquivo .env está no .gitignore e NUNCA deve ser versionado.
#
#      cp .env.exemplo .env        (Linux/macOS)
#      copy .env.exemplo .env      (Windows)
# ============================================================================

# Senha do usuário "sa" do SQL Server.
# Exigência do SQL Server: mínimo 8 caracteres, com maiúscula, minúscula,
# número e símbolo.
MSSQL_SA_PASSWORD=TrocarEstaSenha@2026

# Chave de assinatura dos tokens JWT.
# Precisa ter no mínimo 32 bytes (a aplicação valida na inicialização).
# Para gerar uma chave aleatória:
#   PowerShell: [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))
#   Linux:      openssl rand -base64 48
JWT_KEY=troque-por-uma-chave-aleatoria-de-no-minimo-32-bytes

# Conta administrativa criada na primeira execução
ADMIN_CPF=00000000000
ADMIN_EMAIL=admin@lumina.edu.br
ADMIN_SENHA=TrocarEstaSenha@2026
ADMIN_PALAVRA_CHAVE=palavra-de-recuperacao
